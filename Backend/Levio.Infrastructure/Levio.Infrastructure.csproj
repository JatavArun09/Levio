<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.8" />
    <!-- Override SqlClient's vulnerable transitive 9.0.4 dependency. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="../Modules/Levio.Modules.Identity/Levio.Modules.Identity.csproj" />
    <ProjectReference Include="../Modules/Levio.Modules.LeaveManagement/Levio.Modules.LeaveManagement.csproj" />
    <ProjectReference Include="../Modules/Levio.Modules.Auditing/Levio.Modules.Auditing.csproj" />
  </ItemGroup>
</Project>
